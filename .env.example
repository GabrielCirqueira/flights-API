# Configurações do Google Flights / Localização Padrão
FLIGHTS_LANGUAGE=pt-BR
FLIGHTS_COUNTRY=BR
FLIGHTS_CURRENCY=BRL

# Timeout das requisições upstream (em segundos)
REQUEST_TIMEOUT_SECONDS=20

# Janela padrão (dias) para busca sem data — hoje até hoje+N
OPEN_SEARCH_WINDOW_DAYS=90

# Token de autenticação interna entre Symfony e Flights API (Opcional em dev, Recomendado em prod)
FLIGHTS_API_INTERNAL_TOKEN=voobarato_secret_token_12345

# CORS — origens extras (vírgula), somadas aos localhost de dev (8010, 3000).
# CORS_ORIGINS=https://seu-app.exemplo.com

# Proxy HTTPS para Google Flights (obrigatório em VPS/datacenter — IP residencial).
# FLIGHTS_HTTPS_PROXY=http://usuario:senha@proxy.exemplo.com:8080
# Alternativa padrão do sistema: HTTPS_PROXY=...

# Host do Uvicorn (make dev / make run). Padrão: 0.0.0.0 (Docker). Use 127.0.0.1 para só localhost.
# HOST=0.0.0.0
